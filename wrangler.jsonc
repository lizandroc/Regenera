// Cloudflare Worker config used when the build runs from the repository root.
// It points at the same site and form handler as cloudflare/wrangler.jsonc.
{
  "name": "regenera",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./cloudflare/public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/admin", "/admin/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "regenera-inquiries", "database_id": "08cb4e1a-cbbe-4075-86a1-9362924867a6" }
  ],
  // Not secret: the Zero Trust team that signs /admin logins (shown on the Access login page).
  "vars": { "ACCESS_TEAM_DOMAIN": "blue-mouse-2582.cloudflareaccess.com" },
  "keep_vars": true,
  "observability": { "enabled": true }
}
