// Cloudflare Workers config: serves public/ as static assets and runs worker.js for /api/*.
{
  "name": "regenera",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/admin", "/admin/*"]
  },
  // Keep variables set in the dashboard (MAIL_FROM, MAIL_TO) on each deploy.
  "d1_databases": [
    { "binding": "DB", "database_name": "regenera-inquiries", "database_id": "08cb4e1a-cbbe-4075-86a1-9362924867a6" }
  ],
  // Not secret: the Zero Trust team that signs /admin logins (shown on the Access login page).
  "vars": { "ACCESS_TEAM_DOMAIN": "blue-mouse-2582.cloudflareaccess.com" },
  "keep_vars": true,
  "observability": { "enabled": true }
}
